<% html_title t(:label_administration), t(:label_mattermost) %>

<section class="form--section">
  <p class="op-toast -info">
    <%= t(:help_mattermost_one_bot_many_channels) %>
  </p>
</section>

<%= styled_form_tag({ action: :update }, method: :patch) do %>
  <section class="form--section">
    <h2><%= t(:label_mattermost_bot) %></h2>
    <div class="form--field">
      <%= styled_label_tag "settings_server_url", t(:label_mattermost_server_url) %>
      <div class="form--field-container">
        <%= styled_text_field_tag "settings[server_url]", @settings["server_url"], container_class: "-wide" %>
      </div>
      <div class="form--field-instructions">
        <%= t(:help_mattermost_server_url) %>
      </div>
    </div>
    <div class="form--field">
      <%= styled_label_tag "settings_bot_token", t(:label_mattermost_bot_token) %>
      <div class="form--field-container">
        <%= styled_password_field_tag "settings[bot_token]", @settings["bot_token"], container_class: "-wide", autocomplete: "off" %>
      </div>
      <div class="form--field-instructions">
        <%= t(:help_mattermost_bot_token) %>
      </div>
    </div>
    <div class="form--field">
      <%= styled_label_tag "settings_bot_name", t(:label_mattermost_bot_name) %>
      <div class="form--field-container">
        <%= styled_text_field_tag "settings[bot_name]", @settings["bot_name"] %>
      </div>
    </div>
  </section>

  <section class="form--section">
    <h2><%= t(:label_mattermost_workflow_fields) %></h2>
    <p class="form--field-instructions"><%= t(:help_mattermost_workflow_fields) %></p>
    <% OpenProject::Mattermost::CardFields.workflows.each do |workflow| %>
      <fieldset class="form--fieldset" style="margin: 1rem 0; padding: 0.75rem 1rem;">
        <legend><strong><%= workflow[:name] %></strong></legend>
        <% unless workflow[:id] == "default" %>
          <%= hidden_field_tag "card_fields[#{workflow[:id]}][use_default]", "0" %>
          <label class="form--label-with-check-box" style="display:block; margin-bottom: 0.5rem;">
            <%= check_box_tag "card_fields[#{workflow[:id]}][use_default]", "1", workflow[:use_default] %>
            <%= t(:label_mattermost_use_default_fields) %>
          </label>
        <% end %>
        <%= hidden_field_tag "card_fields[#{workflow[:id]}][fields][]", "" %>
        <div style="display:flex; flex-wrap:wrap; gap: 0.35rem 1rem;">
          <% workflow[:fields].each do |field| %>
            <label class="form--label-with-check-box">
              <%= check_box_tag "card_fields[#{workflow[:id]}][fields][]", field[:key], workflow[:selected].include?(field[:key]) %>
              <%= field[:label] %>
            </label>
          <% end %>
        </div>
      </fieldset>
    <% end %>
  </section>
  <%= styled_button_tag t(:button_save), class: "-primary" %>
<% end %>

<%= styled_form_tag({ controller: "/mattermost/admin_settings", action: :test }, method: :post) do %>
  <section class="form--section">
    <h2><%= t(:label_mattermost_test) %></h2>
    <p class="form--field-instructions"><%= t(:help_mattermost_test_bot) %></p>
    <%= styled_button_tag t(:button_mattermost_test_bot) %>
  </section>
<% end %>
